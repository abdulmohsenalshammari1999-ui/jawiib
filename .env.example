# ── App identity ─────────────────────────────────────────────────────────────
VITE_APP_URL=jawib.app

# ── Platform  (web | ios | android) ──────────────────────────────────────────
# Set to 'ios' or 'android' only in your Capacitor build pipeline.
# Leave as 'web' (or unset) for Netlify web builds.
VITE_PLATFORM=web

# ── Currency (web / non-IAP builds) ──────────────────────────────────────────
VITE_CURRENCY_LABEL=د.ك
VITE_CURRENCY_AMOUNT=4

# ── Web payment (used when VITE_PLATFORM=web) ────────────────────────────────
# Set one of these. If neither is set, the payment gate is disabled (free play).
VITE_PAYMENT_URL=
VITE_SUPPORT_WHATSAPP=    # e.g. 96512345678 — no + or spaces

# ── Native IAP — RevenueCat ───────────────────────────────────────────────────
# 1. Create a project at app.revenuecat.com
# 2. Add your iOS/Android app and paste the platform-specific public API key below
# 3. Create an Entitlement with ID "full_game"
# 4. Create a Non-Consumable product in App Store Connect (ID: jawib_full_game)
# 5. Attach the product to the entitlement in RevenueCat
VITE_REVENUECAT_API_KEY=    # appl_xxxx (iOS) or goog_xxxx (Android)
VITE_IAP_ENTITLEMENT=full_game

# ── Online multiplayer — PartyKit ─────────────────────────────────────────────
# After running `npm run party:deploy`, set the assigned host URL here.
# Leave empty to run fully offline / same-device.
VITE_PARTYKIT_HOST=    # e.g. jawib-game.yourname.partykit.dev

# ── Questions CSV (optional Google Sheets override) ───────────────────────────
# VITE_QUESTIONS_CSV_URL=https://docs.google.com/spreadsheets/d/.../export?format=csv

# ── Seasonal theme ────────────────────────────────────────────────────────────
# VITE_SEASONAL_THEME=ramadan
